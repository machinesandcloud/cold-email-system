{
  "name": "cold-email-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --loader ts-node/esm src/server.ts",
    "worker": "node --env-file=.env --loader ts-node/esm src/worker.ts",
    "dispatch": "node --env-file=.env --loader ts-node/esm src/dispatch.ts",
    "scheduler": "node --env-file=.env --loader ts-node/esm src/scheduler.ts",
    "build": "tsc -p tsconfig.json",
    "start": "npx prisma db push && node dist/server.js",
    "start:worker": "node dist/worker.js",
    "start:scheduler": "node dist/scheduler.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "bullmq": "^5.10.4",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.0",
    "helmet": "^7.1.0",
    "nanoid": "^5.0.7",
    "pino": "^9.3.2",
    "pino-http": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.14.12",
    "prisma": "^5.17.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
